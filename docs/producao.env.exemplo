# =============================================================================
# WECTI - variaveis de ambiente de PRODUCAO
# =============================================================================
# Copie estes valores para o painel da hospedagem (ou para o application.yml
# externo em appservers/standalone, se o painel nao tiver campo de variavel).
#
# NAO comite este arquivo preenchido com as senhas reais. Ele esta aqui como
# modelo: os campos marcados com <<< >>> precisam ser preenchidos na hora do
# deploy.
# =============================================================================


# --- Banco de dados -------------------------------------------------------
# Sem DB_USER e DB_PASSWORD a aplicacao NAO sobe (proposital: senha de
# producao nunca fica no codigo-fonte).
#
# Use os nomes COMPLETOS que o cPanel mostra depois de criar - ele prefixa
# tudo com a conta (ex.: jadir9152_wecti, jadir9152_admin).
DB_USER=<<< usuario do MySQL, com o prefixo da conta >>>
DB_PASSWORD=<<< senha do MySQL >>>

# Nome do banco. Se for exatamente "jadir9152_wecti" pode deixar comentado
# (e o padrao). Se for outro, descomente e corrija - errar aqui e o motivo
# mais comum de a aplicacao subir e nao conectar.
# DB_NAME=jadir9152_wecti

# Host e porta do MySQL. Em hospedagem compartilhada quase sempre sao estes
# valores; so mexa se o painel indicar outro.
# DB_HOST=localhost
# DB_PORT=3306


# --- Chave de assinatura dos tokens de login ------------------------------
# Precisa ser longa, aleatoria e EXCLUSIVA de producao - nunca a mesma usada
# em desenvolvimento. Quem tiver esta chave consegue forjar um token de
# administrador.
#
# Gere com:  openssl rand -base64 48
JWT_SECRET=<<< cole aqui o valor gerado >>>


# --- Enderecos ------------------------------------------------------------
# Dominio do site. Substitui por completo o padrao de desenvolvimento (que
# libera localhost e redes locais). Sem isto, o navegador bloqueia todas as
# chamadas do site para a API.
CORS_ALLOWED_ORIGINS=https://jadir9152.c44.integrator.host

# Endereco de reserva usado ao montar os links dentro dos QR codes.
FRONTEND_URL=https://jadir9152.c44.integrator.host


# --- Documentacao da API --------------------------------------------------
# Desliga /docs e /api-docs. Nao ha motivo pra deixar o mapa completo dos
# endpoints aberto ao publico.
SPRINGDOC_ENABLED=false


# --- Limite de tentativas de login ----------------------------------------
# Opcionais: estes ja sao os valores padrao. Conta apenas tentativas que
# FALHAM, entao a turma inteira acessando pelo mesmo Wi-Fi do campus nao se
# bloqueia. Aumente RATE_LIMIT_MAX_FALHAS se houver reclamacao de bloqueio
# indevido; diminua se houver suspeita de ataque.
RATE_LIMIT_MAX_FALHAS=10
RATE_LIMIT_JANELA_MINUTOS=15


# --- Prazo de inscricao ---------------------------------------------------
# Opcional: este ja e o valor padrao.
#
# Folga, em minutos apos o horario de inicio, em que o aluno ainda
# consegue se inscrever (e cancelar). Existe para quem chega atrasado:
# sem ela, quem aparece 5 minutos depois do comeco nao se inscreve, logo
# nao faz check-in, logo nao pontua.
#
# NAO passe de 30: a pontuacao exige 75% de permanencia, e numa palestra
# de 2 horas quem entra 30 min atrasado fica com exatamente 90 min de 120
# - ou seja, 30 min ja e o limite. Uma folga maior deixaria o aluno se
# inscrever numa palestra em que ele nao tem mais como alcancar a
# presenca minima: ele acha que vai pontuar e nao pontua.
INSCRICAO_TOLERANCIA_MINUTOS=15


# --- Pontuacao ------------------------------------------------------------
# Opcionais: estes ja sao os valores padrao.
#
# Quanto custa reservar vaga e nao aparecer (no-show). Valor FIXO, e nao
# os pontos daquela palestra: antes, faltar numa palestra de 50 pontos
# custava 50 e faltar numa de 300 custava 300 - quem pegava vaga na
# palestra mais concorrida e nao ia era quem mais perdia, embora a vaga
# desperdicada seja a mesma nos dois casos.
PONTUACAO_PENALIDADE_NO_SHOW=100

# Teto de pontos que da para GANHAR em palestras. O teto apara so os
# ganhos; a penalidade acima e descontada DEPOIS dele - senao quem ja
# estivesse acima do teto faltaria de graca.
#
# Pontos de gincana (lancados a mao pelo admin) ficam FORA deste teto:
# sao premiacao, nao pontuacao de palestra.
PONTUACAO_LIMITE_EVENTOS=2000


# --- QR code de check-in --------------------------------------------------
# Opcionais: estes ja sao os valores padrao.
#
# O QR fica projetado e e o mesmo pra sala inteira, entao o link que ele
# carrega tem um codigo que se renova a cada JANELA segundos - a tela do
# admin busca o QR seguinte sozinha. Um print mandado no grupo vence junto
# com a janela em que foi tirado.
#
# Menor = print compartilhado morre mais rapido. Maior = mais folga pra
# quem escaneou e ainda teve que fazer login antes de confirmar. Nao
# deixe abaixo de ~30s: aluno com internet ruim comeca a perder check-in
# legitimo.
CHECKIN_JANELA_CODIGO_SEGUNDOS=60

# A sessao de check-in vale pelo horario do proprio evento, mais estas
# folgas (antes valia 6h a partir da criacao). Aumente a de depois se as
# palestras costumam atrasar.
#
# ATENCAO: se este arquivo ja foi copiado para o painel da hospedagem, a
# variavel definida la VENCE o padrao do codigo. Mudar o padrao no
# repositorio nao tem efeito nenhum enquanto o painel disser outra coisa
# - confira o valor no painel depois de atualizar a aplicacao.
CHECKIN_TOLERANCIA_ANTES_MINUTOS=60
CHECKIN_TOLERANCIA_DEPOIS_MINUTOS=30


# --- Nao mexer ------------------------------------------------------------
# Ja vem correto na aplicacao. So altere se o servidor web NAO estiver na
# frente da aplicacao (sem proxy/HTTPS), caso em que o valor deve ser "none".
# FORWARD_HEADERS_STRATEGY=framework
