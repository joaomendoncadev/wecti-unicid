# Copie para "/opt/wecti/.env" no servidor, ao lado do compose.prod.yml.
# NAO comite este arquivo preenchido - contem segredos de producao.
#
# Quem le o que:
#   - o compose (compose.prod.yml), para passar ao MySQL e a API
#   - os scripts de backup e restauracao
# O frontend NAO le daqui: o endereco da API entra no build pelo GitHub
# Actions (variavel de repositorio VITE_API_URL), porque ele fica GRAVADO
# dentro dos arquivos gerados - trocar a variavel depois do build nao tem
# efeito nenhum.

DB_NAME=wecti
DB_USER=wecti_app
DB_PASSWORD=<<< gere com: openssl rand -base64 24 >>>
DB_ROOT_PASSWORD=<<< gere com: openssl rand -base64 24 (diferente da senha acima) >>>

# Assina os tokens de login. Precisa ser EXCLUSIVO de producao: quem tem esta
# chave forja um token de admin.
JWT_SECRET=<<< gere com: openssl rand -base64 48 >>>

# De onde o NAVEGADOR chama a API - ou seja, o endereco do site, nunca o da
# API. Sem isto o navegador bloqueia todas as chamadas.
CORS_ALLOWED_ORIGINS=https://wecti.com.br,https://www.wecti.com.br

# Endereco usado para montar o link embutido no QR code de check-in.
FRONTEND_URL=https://wecti.com.br

# Desliga /docs e /api-docs. Nao ha motivo para deixar o mapa dos endpoints
# aberto ao publico.
SPRINGDOC_ENABLED=false

# --- Versao da API em execucao ---------------------------------------------
# Tag da imagem no GHCR. O deploy pelo GitHub Actions reescreve esta linha com
# o SHA do commit publicado, e e ela que permite o rollback imediato:
#
#   WECTI_TAG=<sha anterior> docker compose -f compose.prod.yml up -d api
#
# "latest" so e usado se a linha estiver ausente - e um padrao de emergencia,
# nao o modo normal de operar: com "latest" nao da para saber o que esta no ar
# nem para voltar para uma versao especifica.
WECTI_TAG=latest
